{
  "name": "trading-company-hq",
  "version": "0.0.0",
  "description": "Private Trading Company HQ application foundation",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:visual-system": "node scripts/check-visual-system.mjs",
    "check:hq-shell": "node scripts/check-hq-shell.mjs",
    "dev": "CLOUDFLARE_ENV=dev vite --host 127.0.0.1",
    "build": "npm run build:dev",
    "build:dev": "CLOUDFLARE_ENV=dev vite build",
    "build:prod": "CLOUDFLARE_ENV=prod vite build",
    "deploy:dev:dry-run": "npm run build:dev && wrangler deploy --env dev --dry-run",
    "deploy:dev": "npm run build:dev && wrangler deploy --env dev",
    "preview": "CLOUDFLARE_ENV=dev vite preview --host 127.0.0.1",
    "cf-typegen": "wrangler types --env dev && node scripts/normalize-generated-types.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "npm run check:foundation && npm run check:visual-system && npm run check:hq-shell && vitest run",
    "check": "npm run cf-typegen && npm run check:secrets && npm run typecheck && npm run lint && npm test && npm run build:dev && npm run build:prod"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^17.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
