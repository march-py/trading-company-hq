{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trading-company-hq",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "env": {
    "dev": {
      "name": "trading-company-hq-dev",
      "vars": {
        "APP_ENV": "dev",
        "APP_NAME": "trading-company-hq"
      },
      "browser": {
        "binding": "BROWSER"
      },
      "r2_buckets": [
        {
          "binding": "SNAPSHOT_BUCKET",
          "bucket_name": "trading-company-snapshots-dev"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENT_QUEUE",
            "queue": "trading-company-events-dev"
          }
        ],
        "consumers": [
          {
            "queue": "trading-company-events-dev",
            "max_retries": 3,
            "dead_letter_queue": "trading-company-events-dlq-dev",
            "retry_delay": 30
          },
          {
            "queue": "trading-company-events-dlq-dev"
          }
        ]
      },
      "triggers": {
        "crons": [
          "*/15 * * * *"
        ]
      }
    },
    "prod": {
      "name": "trading-company-hq-prod",
      "vars": {
        "APP_ENV": "prod",
        "APP_NAME": "trading-company-hq"
      },
      "browser": {
        "binding": "BROWSER"
      },
      "r2_buckets": [
        {
          "binding": "SNAPSHOT_BUCKET",
          "bucket_name": "trading-company-snapshots-prod"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENT_QUEUE",
            "queue": "trading-company-events-prod"
          }
        ],
        "consumers": [
          {
            "queue": "trading-company-events-prod",
            "max_retries": 3,
            "dead_letter_queue": "trading-company-events-dlq-prod",
            "retry_delay": 30
          },
          {
            "queue": "trading-company-events-dlq-prod"
          }
        ]
      },
      "triggers": {
        "crons": [
          "*/15 * * * *"
        ]
      }
    }
  }
}
